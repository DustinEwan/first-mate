#!/bin/sh
# Conventional Commits gate (https://www.conventionalcommits.org).
# Pure POSIX sh: runs in Git for Windows' bundled sh with no node/npm.
# Enable once per clone: git config core.hooksPath .githooks

msg_file="$1"
# First non-empty line, CR-stripped (CRLF checkouts).
subject=$(tr -d '\r' < "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# fixup!/squash! auto-squash markers pass through untouched.
case "$subject" in
  fixup!* | squash!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._-]+\))?!?: .{1,72}([[:space:]].*)?$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
✗ Commit message must follow Conventional Commits:

    <type>(<optional scope>): <subject>

  types: feat fix docs style refactor perf test build ci chore revert
  add "!" before ":" for breaking changes; subject 1-72 chars, required.

  e.g.  fix(wizard): keep install button above the fold
        feat: add hover-delete for conversations

  Got:
EOF
  printf '        %s\n' "$subject" >&2
  exit 1
fi

# Body lines (if any) must wrap at 100.
long=$(tr -d '\r' < "$msg_file" | sed '1d' | awk 'length > 100 { print; exit }')
if [ -n "$long" ]; then
  echo "✗ Commit body line over 100 characters:" >&2
  printf '        %s\n' "$long" >&2
  exit 1
fi

exit 0
